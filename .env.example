# ==============================================================================
# Google Photos MVP — Environment Configuration
# ==============================================================================

# --- Offline Data Preparation Scripts Only (NEVER expose in Vercel/Client) ---
# Used by scripts/download_pixabay.py & scripts/tag_library.py
PIXABAY_API_KEY=your_pixabay_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini Vision models used: gemini-3.6-flash, gemini-3.7-flash, gemini-3.5-flash-lite, gemini-3.8-flash (all >= 3.5 Flash)
GEMINI_MODEL=gemini-3.6-flash

# --- Runtime Variables (Required for Vercel / Local Server) ---
# Groq runtime query composition (S5 Prompt Composer)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Moderator Console PIN (Default: 1234)
MODERATOR_PIN=1234

# Study session timeout in seconds (Default: 180)
TASK_TIME_LIMIT_SEC=180

# --- Database & Storage (Optional, defaults to local JSON events store) ---
DATABASE_URL=
# For Supabase / Postgres: postgresql://user:pass@host:5432/dbname
