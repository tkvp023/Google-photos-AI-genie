# ==============================================================================
# Google Photos AI Genie MVP — Environment Configuration
# Deployment: Vercel (Frontend) + Railway (Backend) OR All-in-one
# ==============================================================================

# Master Genie Feature Toggle (Default: true)
GENIE_ENABLED=true

# Optional client-facing app name
NEXT_PUBLIC_APP_NAME="Google Photos AI Genie"

# If Frontend is deployed on Vercel and Backend on Railway:
# Set BACKEND_URL on Vercel to your Railway app URL (e.g., https://your-app.up.railway.app)
# Vercel will transparently proxy /api/* requests to Railway (zero CORS issues).
BACKEND_URL=

# Optional LLM API Key (used for optional question generation / prompt assistance)
# If unset, Genie runs entirely deterministically in-memory without external calls.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PLANNER_ENABLED=false
