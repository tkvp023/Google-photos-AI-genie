# ==============================================================================
# Google Photos AI Genie MVP — Environment Configuration
# Architecture: Single Stateless Service (Vercel or Railway)
# ==============================================================================

# Genie Feature Toggle (Default: true)
GENIE_ENABLED=true

# Optional client-facing app name
NEXT_PUBLIC_APP_NAME="Google Photos AI Genie"

# Optional LLM API Key (used offline for question generation / prompt assistance)
# If unset, Genie runs entirely deterministically in-memory.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
