# ==============================================================================
# Google Photos MVP — Environment Configuration
# Architecture: Vercel (Frontend) + Railway (Backend API & Persistent Data)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Set in Vercel Project Settings)
# ------------------------------------------------------------------------------
# The public HTTPS URL of your Railway backend service (e.g. https://my-backend.up.railway.app)
# Next.js will automatically proxy all /api/* requests to this destination without CORS issues.
BACKEND_URL=https://your-railway-app.up.railway.app

# Optional client-facing app name
NEXT_PUBLIC_APP_NAME="Google Photos AI Coach"

# ------------------------------------------------------------------------------
# 2. BACKEND CONFIGURATION (Set in Railway Service Variables)
# ------------------------------------------------------------------------------
# Groq LLM API Key for S5 Pre-Search Prompt Composer
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Moderator Console & CSV Export PIN (Default: 1234)
MODERATOR_PIN=1234

# Study task timeout in seconds (Default: 180)
TASK_TIME_LIMIT_SEC=180

# CORS Allowed Origin for direct API queries (e.g. https://your-frontend.vercel.app or * for all)
ALLOWED_ORIGIN=*

# Optional Railway Persistent Volume mount path (Default: ./data)
# If you attach a persistent volume to /data on Railway, set this to /data
DATA_DIR=

# Optional standalone output toggle
NEXT_OUTPUT_STANDALONE=false

# ------------------------------------------------------------------------------
# 3. OFFLINE DATA GENERATION (Local Terminal Only — NEVER set in Vercel/Railway)
# ------------------------------------------------------------------------------
# Used offline by scripts/download_pixabay.py & scripts/tag_library.py
PIXABAY_API_KEY=your_pixabay_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
